agilemarkdown
agilemarkdown_bash_autocomplete

# Rust build output
/target/

# Coverage artifacts
/lcov.info
*.profraw

# TermKrush runtime store (downloaded tracks, cache, recordings)
/.termkrush/

# Recorded / downloaded audio should never be committed
*.mp3
# ...except the CC0 synthesized test fixtures, which are intentionally tracked.
!/tests/fixtures/*.mp3

# Local dev song library: keep the folder, ignore its audio contents
/songs/*
!/songs/.gitkeep
